#!/usr/bin/env bash
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

if [[ ! -f package.json ]]; then
  exit 0
fi

if [[ ! -f src/lib/project-index/cli/index-cmd.ts ]]; then
  exit 0
fi

if command -v npx >/dev/null 2>&1; then
  npx --no-install tsx src/lib/project-index/cli/index-cmd.ts --if-stale --no-interaction >/dev/null 2>&1 || true
fi
exit 0
